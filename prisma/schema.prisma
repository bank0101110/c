generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Product {
  id Int @id @default(autoincrement())
  name String
  imageUrl String?
  baseQty QtyType @relation(fields: [qtyTypeId],references: [id])
  qtyTypeId Int
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt
  CreatedAt DateTime @default(now())
  ProductQtyType ProductQtyType[]
  ProductHistory ProductHistory[]
}
model QtyType{
  id Int @id @default(autoincrement())
  name String
  products Product[]
  productQtyType ProductQtyType[]
}
model ProductQtyType{
  id Int @id @default(autoincrement())
  ProductId Int
  product Product @relation(fields: [ProductId],references: [id],onDelete: Cascade)
  qtyTypeId Int
  qtyType QtyType @relation(fields: [qtyTypeId],references: [id])
  qty Int
  @@unique([ProductId,qtyTypeId])
  ProductHistory ProductHistory[]
}

model User{
  id Int @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
  ProductHistory ProductHistory[]
}


model ProductHistory{
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId],references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id])
  productQtyTypeId Int
  productQtyType   ProductQtyType @relation(fields: [productQtyTypeId], references: [id], onDelete: Cascade)
  changeQty     Int         // จำนวนที่ปรับเพิ่ม (+) หรือลด (-)
  oldQty        Int         // ยอดก่อนปรับ
  newQty        Int         // ยอดหลังปรับ
  type          ActionType  // ชนิดรายการ (IN, OUT, ADJUSTMENT)
  note          String?     // หมายเหตุ
  createdAt     DateTime    @default(now())
}

enum ActionType {
  IN
  OUT
  ADJUSTMENT
}