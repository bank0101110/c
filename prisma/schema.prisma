generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ชื่อ model/field ในโค้ดใช้ UnitType แต่ @map ตรึงชื่อตาราง-คอลัมน์เดิมใน DB ไว้
// ข้อมูลเดิมเลยใช้ต่อได้ทันทีโดยไม่ต้อง migrate
model Product {
  id Int @id @default(autoincrement())
  name String
  imageUrl String?
  qty Int @default(0)          // ยอดคงเหลือ เก็บเป็นหน่วยย่อยที่สุด (factor = 1)
  baseUnit UnitType @relation(fields: [unitTypeId],references: [id])
  unitTypeId Int @map("qtyTypeId")   // หน่วยที่ใช้แสดงผลเป็นหลัก
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt
  // คนที่สร้างสินค้านี้ — แก้ไข/ลบ/เปลี่ยนหน่วยได้เฉพาะเจ้าของ คนอื่นตัดสต็อกเข้า-ออกได้อย่างเดียว
  // null = ของเก่าที่สร้างก่อนมีระบบเจ้าของ, ลบ user แล้วสินค้าต้องไม่หายตามไปด้วย
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ProductUnitType ProductUnitType[]
  ProductHistory ProductHistory[]

  @@index([ownerId])
}
model UnitType{
  id Int @id @default(autoincrement())
  name String
  qty Int @default(1)          // 1 หน่วยนี้ = กี่หน่วยย่อย เช่น ลัง = 12
  products Product[]
  productUnitType ProductUnitType[]

  @@map("QtyType")
}
model ProductUnitType{
  id Int @id @default(autoincrement())
  ProductId Int
  product Product @relation(fields: [ProductId],references: [id],onDelete: Cascade)
  unitTypeId Int @map("qtyTypeId")
  unitType UnitType @relation(fields: [unitTypeId],references: [id])
  ProductHistory ProductHistory[]

  @@unique([ProductId,unitTypeId])
  @@map("ProductQtyType")
}

// ตาราง auth 4 ตัวข้างล่างเป็น schema มาตรฐานของ Better Auth (สร้างจาก
// `npx @better-auth/cli generate`) ห้ามเปลี่ยนชื่อฟิลด์/ตาราง ไม่งั้น adapter หาไม่เจอ
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ProductHistory ProductHistory[]
  products      Product[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


model ProductHistory{
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId],references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUnitTypeId Int? @map("productQtyTypeId")
  productUnitType   ProductUnitType? @relation(fields: [productUnitTypeId], references: [id], onDelete: SetNull)
  unitName      String      // ชื่อหน่วยตอนที่บันทึก (กันหน่วยถูกลบ/แก้ทีหลัง)
  unitAmount    Int         // จำนวนตามหน่วยที่ผู้ใช้กรอก
  changeQty     Int         // จำนวนที่ปรับเพิ่ม (+) หรือลด (-) เป็นหน่วยย่อย
  oldQty        Int         // ยอดก่อนปรับ เป็นหน่วยย่อย
  newQty        Int         // ยอดหลังปรับ เป็นหน่วยย่อย
  type          ActionType  // ชนิดรายการ (IN, OUT, ADJUSTMENT)
  note          String?     // หมายเหตุ
  createdAt     DateTime    @default(now())
}

enum ActionType {
  IN
  OUT
  ADJUSTMENT
}
