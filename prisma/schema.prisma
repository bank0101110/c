generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ชื่อ model/field ในโค้ดใช้ UnitType แต่ @map ตรึงชื่อตาราง-คอลัมน์เดิมใน DB ไว้
// ข้อมูลเดิมเลยใช้ต่อได้ทันทีโดยไม่ต้อง migrate
model Product {
  id Int @id @default(autoincrement())
  name String
  imageUrl String?
  qty Int @default(0)          // ยอดคงเหลือ เก็บเป็นหน่วยย่อยที่สุด (factor = 1)
  baseUnit UnitType @relation(fields: [unitTypeId],references: [id])
  unitTypeId Int @map("qtyTypeId")   // หน่วยที่ใช้แสดงผลเป็นหลัก
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt
  // คนที่สร้างสินค้านี้ — แก้ไข/ลบ/เปลี่ยนหน่วยได้เฉพาะเจ้าของ คนอื่นตัดสต็อกเข้า-ออกได้อย่างเดียว
  // null = ของเก่าที่สร้างก่อนมีระบบเจ้าของ, ลบ user แล้วสินค้าต้องไม่หายตามไปด้วย
  ownerId String?
  owner User? @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // หมวดหมู่ไม่บังคับ — สินค้าที่ยังไม่จัดหมวดจะขึ้นกลุ่ม "ไม่มีหมวดหมู่"
  // ลบหมวดแล้วสินค้าต้องไม่หายตาม เลยเป็น SetNull
  categoryId Int?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // หมายเหตุประจำสินค้า — ที่เก็บของ/จุดวาง/ย้ายโกดัง พร้อมรูปถ่ายจุดวางไว้ให้คนอื่นดู
  // ใครที่ล็อกอินแล้วแก้ได้ (แนวเดียวกับการตัดสต็อก) เลยเก็บว่าใครแก้ล่าสุดเมื่อไหร่ไว้ด้วย
  note String?
  // รูปจุดวางใส่ได้หลายรูป เก็บเป็น text[] แทนการแตกตาราง — ลำดับใน array คือลำดับที่โชว์
  // และไม่มีที่ไหนต้องอ้างถึงรูปเดี่ยว ๆ ตารางแยกเลยมีแต่ join เพิ่มโดยไม่ได้อะไรกลับมา
  noteImageUrls String[]
  noteUpdatedAt DateTime?
  noteUpdatedById String?
  noteUpdatedBy User? @relation("ProductNoteEditor", fields: [noteUpdatedById], references: [id], onDelete: SetNull)
  ProductUnitType ProductUnitType[]
  ProductHistory ProductHistory[]
  // สินค้าที่มี SKU จะตัดสต็อกที่ระดับ SKU แทน ส่วน Product.qty เป็นยอดรวมที่คิดจาก SKU
  // สินค้าที่ไม่มี SKU ใช้ Product.qty กับ baseUnit ของตัวเองเหมือนเดิม
  skus Sku[]

  @@index([ownerId])
  @@index([categoryId])
}

/// หมวดหมู่สินค้า — ผู้ใช้จัดเอง สินค้าจะไม่มีหมวดก็ได้
model Category {
  id Int @id @default(autoincrement())
  name String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([ownerId])
}

/// ตัวเลือกย่อยของสินค้า (สี/ขนาด/รุ่น) — แต่ละตัวถือสต็อกและหน่วยของตัวเอง
/// เพราะจำนวนต่อหน่วยของแต่ละตัวเลือกไม่เท่ากัน เช่น ถุง 6x9 กับ 12x20 คนละขนาดกัน
model Sku {
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String                  // ชื่อตัวเลือก เช่น "6x14 นิ้ว"
  code String?                 // รหัส SKU ของผู้ขาย (ถ้ามี)
  imageUrl String?
  qty Int @default(0)          // ยอดคงเหลือ เก็บเป็นหน่วยย่อยที่สุด เหมือน Product.qty
  baseUnit UnitType @relation("SkuBaseUnit", fields: [unitTypeId], references: [id])
  unitTypeId Int               // หน่วยหลักของตัวเลือกนี้ ต้องเป็น ×1
  // หน่วยที่จะถูกเลือกให้อัตโนมัติตอนใครก็ตามเปิดหน้าสินค้ามาตัดสต็อก — ตั้งจากหน้าจัดการ
  // null = ใช้หน่วยหลัก (พฤติกรรมเดิม) ต้องเป็นหน่วยที่ตัวเลือกนี้รองรับเท่านั้น
  defaultUnitTypeId Int?
  defaultUnit UnitType? @relation("SkuDefaultUnit", fields: [defaultUnitTypeId], references: [id])
  SkuUnitType SkuUnitType[]
  ProductHistory ProductHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ชื่อตัวเลือกห้ามซ้ำภายในสินค้าเดียวกัน กันสับสนตอนเลือกปรับสต็อก
  @@unique([productId, name])
  @@index([productId])
}

/// หน่วยเสริมของ SKU — โครงเดียวกับ ProductUnitType แต่ผูกกับตัวเลือกย่อย
model SkuUnitType {
  id Int @id @default(autoincrement())
  skuId Int
  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  unitTypeId Int
  unitType UnitType @relation(fields: [unitTypeId], references: [id])

  @@unique([skuId, unitTypeId])
}
model UnitType{
  id Int @id @default(autoincrement())
  name String
  qty Int @default(1)          // 1 หน่วยนี้ = กี่หน่วยย่อย เช่น ลัง = 12
  products Product[]
  productUnitType ProductUnitType[]
  skus Sku[] @relation("SkuBaseUnit")
  defaultSkus Sku[] @relation("SkuDefaultUnit")
  skuUnitType SkuUnitType[]

  @@map("QtyType")
}
model ProductUnitType{
  id Int @id @default(autoincrement())
  ProductId Int
  product Product @relation(fields: [ProductId],references: [id],onDelete: Cascade)
  unitTypeId Int @map("qtyTypeId")
  unitType UnitType @relation(fields: [unitTypeId],references: [id])
  ProductHistory ProductHistory[]

  @@unique([ProductId,unitTypeId])
  @@map("ProductQtyType")
}

// ตาราง auth 4 ตัวข้างล่างเป็น schema มาตรฐานของ Better Auth (สร้างจาก
// `npx @better-auth/cli generate`) ห้ามเปลี่ยนชื่อฟิลด์/ตาราง ไม่งั้น adapter หาไม่เจอ
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ProductHistory ProductHistory[]
  products      Product[] @relation("ProductOwner")
  notedProducts Product[] @relation("ProductNoteEditor")
  categories    Category[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


model ProductHistory{
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId],references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // รายการที่ตัดสต็อกของตัวเลือกย่อย จะผูก skuId ไว้ด้วย ส่วนสินค้าที่ไม่มี SKU เป็น null
  skuId Int?
  sku Sku? @relation(fields: [skuId], references: [id], onDelete: Cascade)
  productUnitTypeId Int? @map("productQtyTypeId")
  productUnitType   ProductUnitType? @relation(fields: [productUnitTypeId], references: [id], onDelete: SetNull)
  unitName      String      // ชื่อหน่วยตอนที่บันทึก (กันหน่วยถูกลบ/แก้ทีหลัง)
  unitAmount    Int         // จำนวนตามหน่วยที่ผู้ใช้กรอก
  changeQty     Int         // จำนวนที่ปรับเพิ่ม (+) หรือลด (-) เป็นหน่วยย่อย
  oldQty        Int         // ยอดก่อนปรับ เป็นหน่วยย่อย
  newQty        Int         // ยอดหลังปรับ เป็นหน่วยย่อย
  type          ActionType  // ชนิดรายการ (IN, OUT, ADJUSTMENT)
  note          String?     // หมายเหตุ
  createdAt     DateTime    @default(now())
}

enum ActionType {
  IN
  OUT
  ADJUSTMENT
}
